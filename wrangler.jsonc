{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "proj-port-dash",
  "compatibility_date": "2026-08-10",
  "assets": {
    "directory": "./dist/",
    "not_found_handling": "single-page-application"
  },
  "env": {
    "preview": {
      "name": "proj-port-dash-preview",
      "assets": {
        "directory": "./dist/",
        "not_found_handling": "single-page-application"
      }
    }
  }
}
